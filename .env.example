# =============================================================================
# ChoyJiez DELIVERY - Environment Variables (.env.example)
# Secret keys must be configured in Render Dashboard -> Environment.
# Non-secret defaults and public Firebase config are already pre-filled.
# =============================================================================

# Server & Gemini AI (Secret - Set in Render Environment Variables)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server Runtime (Render automatically injects PORT and RENDER_EXTERNAL_URL)
NODE_ENV="production"
PORT="3000"
APP_URL="https://choyjiez-delivery.onrender.com"

# ChoyJiez App Defaults (Pre-filled)
APP_NAME="ChoyJiez DELIVERY"
APP_TAGLINE="All What You Want"
DEFAULT_REGION="Cebu City, Philippines"
DELIVERY_RADIUS_KM="3"
DELIVERY_FEE_TIER_1="25"
DELIVERY_FEE_TIER_2="35"
DELIVERY_FEE_TIER_3="50"

# Public Firebase Client Configuration (Pre-filled from firebase-applet-config.json)
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0125944006"
VITE_FIREBASE_DATABASE_ID="ai-studio-choyjiez-fdb2715d-1f62-41f8-bdf4-44891517ae6a"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0125944006.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0125944006.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="119087823167"
VITE_FIREBASE_APP_ID="1:119087823167:web:0619539cee5db1d9eebb8a"
